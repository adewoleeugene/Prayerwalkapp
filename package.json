{
  "name": "charis-prayer-walk-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm run typecheck && cd admin && npm run build && cd ../mobile && npm run typecheck",
    "lint:backend": "tsc --noEmit",
    "lint:admin": "cd admin && npm run lint",
    "lint:mobile": "cd mobile && npm run typecheck",
    "lint": "npm run lint:backend && npm run lint:admin && npm run lint:mobile",
    "test": "vitest run",
    "test:local": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5432/charis_prayer_walk_test} vitest run",
    "test:watch": "vitest",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:reset:yes": "tsx scripts/db-reset.ts --yes",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.4.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
